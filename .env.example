# Copy this file to .env and fill your real values.

# Database: choose "mysql" or "postgresql"
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Groq API key for LLM (text-to-SQL)
GROQ_API_KEY=your_groq_api_key

# Optional Groq model (see https://console.groq.com/docs/models)
# Do not use retired IDs like llama3-70b-8192 — use e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
